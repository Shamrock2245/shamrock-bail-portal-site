/**
 * backend/signing-methods.jsw
 *
 * Compatibility boundary for retired Wix/GAS-originated signing flows.
 *
 * Active paperwork is DocuSeal-only and is issued by staff in Super CRM after
 * a validated Match, bonded case, explicit surety, assigned POA tier, recipient
 * validation, and staff approval. Wix must not create a packet, generate a
 * signing URL, or send a provider invitation. The portal opens the existing
 * Netlify paperwork launchpad, which may display a staff-issued DocuSeal link.
 *
 * Historical CMS records and safe status reads remain available below. Legacy
 * callers receive a fail-closed response rather than triggering a retired
 * provider workflow.
 */

import { sendSms } from 'backend/twilio-client';
import wixData from 'wix-data';

const DIRECT_PAPERWORK_DISABLED = Object.freeze({
    success: false,
    code: 'LEGACY_DIRECT_PAPERWORK_DISABLED',
    requiresStaffReview: true,
    error: 'Direct paperwork is retired. Staff must issue DocuSeal from Super CRM after the required validation and approval checks.'
});

function legacyDirectPaperworkDisabled() {
    return { ...DIRECT_PAPERWORK_DISABLED };
}

/**
 * Retired: Wix may not request a provider email invitation.
 * @returns {Promise<Object>} A fail-closed response.
 */
export async function sendViaEmail() {
    return legacyDirectPaperworkDisabled();
}

/**
 * Retired: Wix may not generate an SMS signing session or signing URL.
 * @returns {Promise<Object>} A fail-closed response.
 */
export async function sendViaSMS() {
    return legacyDirectPaperworkDisabled();
}

/**
 * Retired: Wix may not generate an embedded/kiosk signing session.
 * @returns {Promise<Object>} A fail-closed response.
 */
export async function createKioskLink() {
    return legacyDirectPaperworkDisabled();
}

/**
 * Retired: Wix may not generate print packets from the legacy direct workflow.
 * @returns {Promise<Object>} A fail-closed response.
 */
export async function generatePrintPDFs() {
    return legacyDirectPaperworkDisabled();
}

/**
 * Read the latest signing-session record without creating, mutating, or sending
 * paperwork. Historical field names are intentionally retained for compatibility.
 * @param {string} caseId
 */
export async function getSigningStatus(caseId) {
    try {
        const results = await wixData.query('Signing Sessions')
            .eq('caseId', caseId)
            .descending('_createdDate')
            .limit(1)
            .find({ suppressAuth: true });

        if (results.items.length > 0) {
            return {
                success: true,
                status: results.items[0].status,
                method: results.items[0].method,
                session: results.items[0]
            };
        }

        return { success: false, message: 'No signing session found' };
    } catch (error) {
        console.error('Error getting signing status:', error);
        return { success: false, error: error.message };
    }
}

/**
 * Read pending-document records only. This function does not expose or create
 * provider links; the active portal uses the DocuSeal launchpad.
 * @param {string} memberId
 */
export async function getPendingDocuments(memberId) {
    try {
        const results = await wixData.query('PendingDocuments')
            .eq('memberId', memberId)
            .eq('status', 'pending')
            .find({ suppressAuth: true });

        return { success: true, documents: results.items };
    } catch (error) {
        console.error('Error getting pending documents:', error);
        return { success: false, error: error.message };
    }
}

/**
 * Preserve historical document-status maintenance for completed records.
 * @param {string} documentId
 */
export async function markDocumentSigned(documentId) {
    try {
        const results = await wixData.query('PendingDocuments')
            .eq('documentId', documentId)
            .limit(1)
            .find({ suppressAuth: true });

        if (results.items.length > 0) {
            const doc = results.items[0];
            doc.status = 'signed';
            doc.signedAt = new Date();
            await wixData.update('PendingDocuments', doc, { suppressAuth: true });
        }

        return { success: true };
    } catch (error) {
        console.error('Error marking document signed:', error);
        return { success: false, error: error.message };
    }
}

/**
 * Retired: all former email/SMS/kiosk/print direct signing routes are blocked.
 * Existing callers remain supported at the API level and receive the standard
 * fail-closed response instead of touching any external provider.
 */
export async function initiateSigningWorkflow() {
    return legacyDirectPaperworkDisabled();
}

/**
 * Deliver a staff-issued signing URL by SMS. This helper does not create a
 * packet or link and is provider-neutral; callers must pass only a verified,
 * staff-issued DocuSeal URL after the Super CRM approval workflow.
 *
 * @param {string} phone
 * @param {string} signingLink
 * @param {'defendant'|'indemnitor'} recipientType
 */
export async function sendSigningLinkViaSms(phone, signingLink, recipientType = 'defendant') {
    if (!phone || !signingLink) {
        return { success: false, error: 'Phone and signing link are required' };
    }

    const recipientLabel = recipientType === 'indemnitor' ? 'You are listed as an indemnitor.' : 'Your bail paperwork is ready.';
    const message = `Shamrock Bail Bonds: ${recipientLabel}\n\nOpen your secure DocuSeal paperwork: ${signingLink}\n\nQuestions? Call (239) 332-2245`;
    return sendSms(phone, message);
}

export const signingWorkflowPolicy = Object.freeze({
    provider: 'DocuSeal',
    packetAuthority: 'Super CRM',
    wixMayCreatePackets: false,
    wixMayGenerateSigningLinks: false,
    wixMayDeliverVerifiedStaffIssuedLinks: true
});
