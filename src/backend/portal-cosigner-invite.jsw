/**
 * Web method: create a co-signer invite for the signed-in indemnitor.
 * The session token is the only identity input. Optional contact fields are
 * forwarded for validation. Case and person ids are never taken from the client.
 * This method does not send a text.
 */

import { getSecret } from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';
import wixData from 'wix-data';
import { validateCustomSession } from 'backend/portal-auth';
import { requestCosignerInvite } from 'backend/portalCosignerInvite';

async function readById(collection, id) {
    try {
        return await wixData.get(collection, id, { suppressAuth: true });
    } catch (e) {
        return null;
    }
}

async function readByCaseField(collection, caseId) {
    try {
        const found = await wixData.query(collection)
            .eq('caseId', caseId)
            .limit(1)
            .find({ suppressAuth: true });
        return found && found.items && found.items[0] ? found.items[0] : null;
    } catch (e) {
        return null;
    }
}

/** Wix _id first, then the canonical caseId field. No ids are logged. */
async function loadPortalCase(identity) {
    const id = identity && typeof identity.caseId === 'string' ? identity.caseId.trim() : '';
    if (!id) return null;
    return await readById('Cases', id)
        || await readById('IntakeQueue', id)
        || await readByCaseField('Cases', id)
        || await readByCaseField('IntakeQueue', id);
}

export async function createCosignerInvite(sessionToken, fields) {
    if (typeof sessionToken !== 'string' || !sessionToken) {
        return { ok: false, reason: 'session' };
    }
    const src = fields && typeof fields === 'object' ? fields : {};
    return requestCosignerInvite({
        sessionToken: sessionToken,
        cosigner_name: src.cosigner_name,
        cosigner_phone: src.cosigner_phone,
        cosigner_email: src.cosigner_email
    }, {
        validateSession: validateCustomSession,
        getSecret: getSecret,
        fetchImpl: fetch,
        loadCase: loadPortalCase
    });
}
