/**
 * BlueBubbles iMessage Bridge Backend Module
 * File: backend/bluebubbles.jsw
 *
 * Wix never talks to the office iMac or bb.shamrockbailbonds.biz.
 * Off-mesh Wix cannot use Tailscale 100.x. Super CRM is the sender:
 *   POST https://leads.shamrockbailbonds.biz/api/imessage/wix/send
 *   Auth: Wix secret LEADS_API_KEY, then GAS_API_KEY.
 *   Headers: X-API-Key and X-Internal-Token.
 * Shannon send is the next hop. Portal sign-in uses the longer chain in
 * portal-signin-dispatch.js (GAS relay, optional Twilio, email, Slack).
 * This module stays dashboard-only so signing receipts do not fall through
 * to Twilio or email.
 *
 * @module bluebubbles
 */

import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';
import { dashboardSend, probeDashboardSend } from 'backend/portal-signin-dispatch';

function deps() {
    return { fetchImpl: fetch, getSecret: getSecret, logger: console };
}

/**
 * Send an iMessage / SMS via Super CRM → office iMac BlueBubbles.
 * Tries /wix/send then /shannon/send. Does not text via Twilio.
 * @param {Object} params
 * @param {string} params.to - Phone number (E.164 or 10-digit)
 * @param {string} [params.phone] - Alias for to
 * @param {string} params.text - Message content
 * @param {string} [params.message] - Alias for text
 * @returns {Promise<{success: boolean, data?: Object, message?: string, messageId?: string, channel?: string, reason?: string}>}
 */
export async function sendBlueBubblesMessage(params) {
    const to = params && (params.to || params.phone);
    const text = params && (params.text || params.message);

    if (!to || !text) {
        return { success: false, reason: 'invalid', message: 'Missing recipient phone or text.' };
    }

    const result = await dashboardSend(deps(), { phone: to, text: String(text) });
    if (result.success) {
        return {
            success: true,
            reason: 'sent',
            data: result.data,
            messageId: result.messageId || '',
            channel: result.channel === 'sms' ? 'sms' : 'imessage'
        };
    }

    const friendly = result.reason === 'auth'
        ? 'Dashboard rejected the sign-in key.'
        : result.reason === 'missing_key'
            ? 'Missing LEADS_API_KEY and GAS_API_KEY for Super CRM iMessage.'
            : result.reason === 'invalid'
                ? 'Invalid recipient phone.'
                : 'Super CRM iMessage was not sent.';
    return { success: false, reason: result.reason || 'unreachable', message: friendly };
}

/**
 * Health + auth probe. No recipient is sent, so no client text goes out.
 * 401 is config_auth_mismatch. 400 on an empty body means the key was accepted.
 * @returns {Promise<{success: boolean, connected?: boolean, pathInUse?: string, sendProbeStatus?: number, reason?: string, keySource?: string, error?: string}>}
 */
export async function probeIMessageBridge() {
    return probeDashboardSend(deps());
}

export default {
    sendBlueBubblesMessage,
    probeIMessageBridge
};
