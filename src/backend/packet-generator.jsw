/**
 * packet-generator.jsw
 * 
 * RETIRED & HARD-LOCKED (2026-08-21)
 * 
 * Boundary Doctrine:
 * Wix NEVER creates DocuSeal packets or signing links.
 * All legal packet issuance is strictly staff-gated inside Super CRM (shamrock-leads).
 * Direct paperwork creation from Wix is permanently disabled.
 * 
 * @module packet-generator
 */

export async function generatePDFPacket(caseId, defendantInfo) {
    console.warn(`🔒 [Packet Generator] Direct packet creation blocked for Case ${caseId}. Paperwork must be issued by staff in Super CRM.`);
    return {
        success: false,
        code: 'DIRECT_PAPERWORK_DISABLED',
        requiresStaffReview: true,
        error: 'Direct paperwork generation is retired. Authorized staff must issue the DocuSeal packet from Super CRM.'
    };
}

export default {
    generatePDFPacket
};
