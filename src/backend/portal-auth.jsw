// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================



/**
 * Normalize email to lowercase
 */
function normalizeEmail(email) {
    return email ? email.toLowerCase().trim() : '';
}

/**
 * Normalize phone number to E.164 format
 */
function normalizePhone(phone) {
    if (!phone) return '';
    let digits = phone.replace(/\D/g, '');
    if (digits.length === 10) {
        return '+1' + digits;
    } else if (digits.length === 11 && digits.startsWith('1')) {
        return '+' + digits;
    }
    return phone;
}

/**
 * Check if input is email or phone
 */
function isEmail(input) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input);
}

// ============================================================================
// STAFF ACCOUNT HELPERS
// ============================================================================

/**
 * Check if email is a hardcoded staff account
 */
/**
 * Check if email is a hardcoded staff account
 */
function isStaffAccount(email, staffConfig) {
    if (!staffConfig) return false;
    const normalized = normalizeEmail(email);
    return staffConfig.hasOwnProperty(normalized);
}

/**
 * Get staff account details
 */
function getStaffAccountDetails(email, staffConfig) {
    if (!staffConfig) return null;
    const normalized = normalizeEmail(email);
    return staffConfig[normalized] || null;
}

// ============================================================================
// USER LOOKUP
// ============================================================================

/**
 * Look up user by email or phone in Cases collection
 * Returns role and person info if found
 */


/**
 * Helper: Build a robust phone query
 * Checks multiple formats: E.164, Raw 10-digit, Formatted
 */
function buildPhoneQuery(collection, field, phoneInput) {
    const variants = phoneLookupVariants(phoneInput);
    if (!variants.length) {
        return wixData.query(collection).eq(field, '__portal_phone_rejected__');
    }
    let query = wixData.query(collection).eq(field, variants[0]);
    for (let i = 1; i < variants.length; i++) {
        query = query.or(wixData.query(collection).eq(field, variants[i]));
    }
    return query;
}

async function firstContactMatch(collection, contact, emailFields, phoneFields, optional) {
    const mail = isEmail(contact);
    const fields = mail ? emailFields : phoneFields;
    const normalized = mail ? normalizeEmail(contact) : contact;
    for (let i = 0; i < fields.length; i++) {
        try {
            let query = mail
                ? wixData.query(collection).eq(fields[i], normalized)
                : buildPhoneQuery(collection, fields[i], contact);
            if (collection === 'IntakeQueue') query = query.descending('_createdDate');
            const found = await query.limit(1).find({ suppressAuth: true });
            if (found.items && found.items.length > 0) return { record: found.items[0], field: fields[i] };
        } catch (e) {
            if (!optional) throw e;
        }
    }
    return null;
}

function packMatchedRecord(record, role, source, matchedField) {
    const intake = source === 'intake';
    const caseId = intake ? (record.caseId || record._id) : record._id;
    const packed = {
        found: true,
        personId: role === 'defendant'
            ? record._id
            : (role === 'coindemnitor'
                ? (cosignerPersonId(record._id, matchedField) || ('coindemnitor_' + record._id))
                : (role + '_' + record._id)),
        role: role,
        caseId: caseId,
        email: null,
        phone: null,
        name: null
    };
    if (role === 'defendant') {
        packed.email = record.defendantEmail;
        packed.phone = record.defendantPhone;
        packed.name = record.defendantName;
    } else if (role === 'coindemnitor') {
        const slot = cosignerContactForField(record, matchedField);
        packed.email = slot.email || null;
        packed.phone = slot.phone || null;
        packed.name = slot.name || null;
    } else {
        packed.email = record.indemnitorEmail;
        packed.phone = record.indemnitorPhone;
        packed.name = record.indemnitorName;
    }
    if (intake) packed.source = 'intake';
    return packed;
}

async function matchRoleInCollection(collection, contact, preferredRole) {
    const source = collection === 'IntakeQueue' ? 'intake' : 'case';
    const [defendant, indemnitor, coindemnitor] = await Promise.all([
        firstContactMatch(collection, contact, ['defendantEmail'], ['defendantPhone'], false),
        firstContactMatch(collection, contact, ['indemnitorEmail'], ['indemnitorPhone'], false),
        firstContactMatch(collection, contact, COINDEMNITOR_EMAIL_FIELDS, COINDEMNITOR_PHONE_FIELDS, true)
    ]);
    if (!defendant && !indemnitor && !coindemnitor) return null;
    const role = resolveSignInRole(preferredRole, {
        defendant: !!defendant,
        indemnitor: !!indemnitor,
        coindemnitor: !!coindemnitor
    });
    const hit = role === 'defendant' ? defendant : (role === 'coindemnitor' ? coindemnitor : indemnitor);
    if (!hit || !hit.record) return null;
    const packed = packMatchedRecord(hit.record, role, source, hit.field);
    console.log(`[OK] Found ${role} in ${collection}: ${packed.caseId}`);
    return packed;
}

/**
 * Look up user by email or phone across Cases AND IntakeQueue collections.
 * Returns role and person info if found.
 *
 * IMPORTANT: Cases collection is the canonical store, but IntakeQueue holds
 * all active leads from Telegram/mini-apps before GAS syncs them to Cases.
 * We must search both to correctly identify returning leads.
 */
export async function lookupUserByContact(contact, preferredRole) {
    try {
        const config = await getConfig();
        const staffConfig = config.staffAccounts || {};
        const cleanPref = String(preferredRole || '').toLowerCase().trim();

        const normalized = isEmail(contact)
            ? normalizeEmail(contact)
            : normalizePhone(contact);

        // 0. Super admin — always full admin (hardcoded; never blocked by missing CMS config)
        if (isEmail(contact) && isSuperAdminEmail(contact)) {
            const superAdmin = getSuperAdminProfile(contact);
            // Prefer tenant.json staffAccounts name/personId when present
            const fromConfig = getStaffAccountDetails(contact, staffConfig);
            console.log(`[OK] Super admin identified: ${superAdmin.email}`);
            return {
                found: true,
                personId: (fromConfig && fromConfig.personId) || superAdmin.personId || SUPER_ADMIN_PERSON_ID,
                role: 'admin',
                email: superAdmin.email,
                name: (fromConfig && fromConfig.name) || superAdmin.name,
                isStaff: true,
                isSuperAdmin: true
            };
        }

        // 1. Check if it's a staff account (tenant.json staffAccounts)
        if (isEmail(contact) && isStaffAccount(contact, staffConfig)) {
            const staffDetails = getStaffAccountDetails(contact, staffConfig);
            const role = elevateRoleIfSuperAdmin(staffDetails.role, contact);
            console.log(`[OK] Staff account identified: ${staffDetails.name} (${role})`);
            return {
                found: true,
                personId: staffDetails.personId,
                role: role,
                email: normalized,
                name: staffDetails.name,
                isStaff: true
            };
        }

        // 2. Cases first, then IntakeQueue. Role comes from the row that matched,
        // not from the tab alone. A primary indemnitor is never labeled co-indemnitor.
        const caseHit = await matchRoleInCollection(CONFIG.CASES_COLLECTION, contact, cleanPref);
        if (caseHit) return caseHit;

        // IntakeQueue holds Telegram/mini-app leads before GAS syncs them to Cases.
        const intakeHit = await matchRoleInCollection('IntakeQueue', contact, cleanPref);
        if (intakeHit) return intakeHit;

        // 4. Not found anywhere — new user, default to indemnitor
        console.log(`[!] Contact not found in Cases or IntakeQueue: ${normalized.substring(0, 6)}...`);
        return {
            found: false,
            contact: normalized
        };

    } catch (error) {
        console.error('Error in lookupUserByContact:', error);
        return { found: false, error: error.message };
    }
}

// ============================================================================
// SESSION MANAGEMENT
// ============================================================================

/**
 * Create a custom session for a user
 * @param {string} personId
 * @param {string} role
 * @param {string} caseId
 * @param {Object} contactInfo - { email, phone, name } (optional)
 */
/**
 * Create a custom session for a user
 * IMPROVED: Reuses existing active session if valid to prevent duplicates
 * @param {string} personId
 * @param {string} role
 * @param {string} caseId
 * @param {Object} contactInfo - { email, phone, name } (optional)
 */
export async function createCustomSession(personId, role, caseId = null, contactInfo = {}) {
    try {
        console.log(` Creating session for ${role} (${personId})...`);

        // HARDENING: Enforce Allowlisted Roles
        const ALLOWED_ROLES = ['indemnitor', 'defendant', 'staff', 'admin', 'coindemnitor'];
        let targetRole = role;
        if (!ALLOWED_ROLES.includes(targetRole)) {
            console.warn(`SECURITY WARNING: Attempted to create session with invalid role '${role}'. Defaulting to 'indemnitor'.`);
            targetRole = 'indemnitor';
        }

        // Super admin always gets admin role (even if caller passed staff/indemnitor by mistake)
        targetRole = elevateRoleIfSuperAdmin(targetRole, contactInfo.email);

        // 1. Check for existing active session to REUSE
        try {
            const existingSessions = await wixData.query(CONFIG.SESSIONS_COLLECTION)
                .eq('personId', personId)
                .eq('role', targetRole)
                .eq('isActive', true)
                .gt('expiresAt', new Date()) // Must be valid
                .descending('createdAt')
                .limit(5)
                .find({ suppressAuth: true });

            for (let i = 0; i < existingSessions.items.length; i++) {
                const activeSession = existingSessions.items[i];
                // Check if it has enough time remaining (e.g., > 4 hours)
                const remainingTime = new Date(activeSession.expiresAt).getTime() - new Date().getTime();
                if (remainingTime <= 4 * 60 * 60 * 1000) continue;
                // Same person id is not enough. Another cosigner on this case
                // must not receive this session.
                if (!sessionContactsCompatible(activeSession, contactInfo)) continue;
                const reuseIsNew = magicLinkIsNewUser({
                    isNewUser: contactInfo.isNewUser === true || activeSession.isNewUser === true,
                    personId: personId
                });
                if (reuseIsNew && activeSession.isNewUser !== true) {
                    activeSession.isNewUser = true;
                    await wixData.update(CONFIG.SESSIONS_COLLECTION, activeSession, { suppressAuth: true });
                }
                console.log(` Reusing existing valid session: ${activeSession._id}`);
                return activeSession.sessionToken;
            }
        } catch (checkErr) {
            console.warn("[!] Error checking existing sessions:", checkErr);
            // Continue to create new one if check fails
        }

        // 2. Create New Session
        const sessionToken = generateToken(48);
        const expiresAt = new Date();
        expiresAt.setHours(expiresAt.getHours() + CONFIG.SESSION_DURATION_HOURS);

        const sessionData = {
            sessionToken: sessionToken,
            personId: personId,
            role: targetRole,
            caseId: caseId,
            email: contactInfo.email || null,
            phone: contactInfo.phone || null,
            name: contactInfo.name || null,
            // Kept on the session so a later visit with the stored token still
            // routes a new indemnitor to paperwork instead of /portal-indemnitor.
            isNewUser: magicLinkIsNewUser({ isNewUser: contactInfo.isNewUser, personId: personId }),
            createdAt: new Date(),
            expiresAt: expiresAt,
            isActive: true
        };

        await wixData.insert(CONFIG.SESSIONS_COLLECTION, sessionData, { suppressAuth: true });

        console.log(`[OK] New Session created for ${personId} with role ${targetRole}`);
        return sessionToken;

    } catch (error) {
        console.error('Error creating session:', error);
        throw error;
    }
}

/**
 * Validate a custom session token
 */
/**
 * Validate a custom session token
 * Returns distinct error states for frontend handling
 */
export async function validateCustomSession(sessionToken) {
    try {
        if (!sessionToken) {
            return { valid: false, reason: 'no_token' };
        }

        // Query multiple potential field keys to be safe
        const results = await wixData.query(CONFIG.SESSIONS_COLLECTION)
            .eq('sessionToken', sessionToken)
            .eq('isActive', true)
            .find({ suppressAuth: true });

        if (results.items.length === 0) {
            console.warn(`[!] Session validation failed: Token not found or inactive. Token: ${sessionToken.substring(0, 10)}...`);
            return { valid: false, reason: 'invalid' };
        }

        const session = results.items[0];

        // Check expiration
        if (new Date(session.expiresAt) < new Date()) {
            console.warn(`[!] Session expired. Expiry: ${session.expiresAt}, Now: ${new Date()}`);
            // Mark as inactive
            session.isActive = false;
            await wixData.update(CONFIG.SESSIONS_COLLECTION, session, { suppressAuth: true });
            return { valid: false, reason: 'expired' };
        }

        // Super admin elevation on every validation (covers legacy sessions minted as staff)
        const effectiveRole = elevateRoleIfSuperAdmin(session.role, session.email);

        return {
            valid: true,
            personId: session.personId,
            role: effectiveRole,
            caseId: session.caseId,
            email: session.email,
            phone: session.phone,
            name: session.name,
            createdAt: session.createdAt,
            expiresAt: session.expiresAt,
            sessionToken: session.sessionToken, // Return for robust checks
            isNewUser: magicLinkIsNewUser(session),
            isSuperAdmin: isSuperAdminEmail(session.email)
        };

    } catch (error) {
        console.error('[X] Error validating session:', error);
        // CRITICAL FIX: Return 'error' reason so frontend knows it's a system/network issue
        // and doesn't immediately log the user out.
        return { valid: false, reason: 'error', message: error.message };
    }
}

/**
 * Invalidate a session (logout)
 */
export async function invalidateSession(sessionToken) {
    try {
        const results = await wixData.query(CONFIG.SESSIONS_COLLECTION)
            .eq('sessionToken', sessionToken)
            .find({ suppressAuth: true });

        if (results.items.length > 0) {
            const session = results.items[0];
            session.isActive = false;
            session.invalidatedAt = new Date();
            await wixData.update(CONFIG.SESSIONS_COLLECTION, session, { suppressAuth: true });
        }

        return { success: true };

    } catch (error) {
        console.error('Error invalidating session:', error);
        return { success: false, error: error.message };
    }
}

// ============================================================================
// MAGIC LINK GENERATION & VALIDATION
// ============================================================================

/**
 * Generate a magic link token
 * @param {string} personId - Person identifier
 * @param {string} role - User role
 * @param {string} caseId - Case identifier (optional)
 * @param {Object} options - { email, phone, name } (optional)
 */
export async function generateMagicLink(personId, role, caseId = null, options = {}) {
    try {
        const token = generateToken(32);
        const expiresAt = new Date();
        expiresAt.setHours(expiresAt.getHours() + CONFIG.MAGIC_LINK_EXPIRY_HOURS);

        const linkData = {
            token: token,
            personId: personId,
            role: role,
            caseId: caseId,
            email: options.email || null,
            phone: options.phone || null,
            name: options.name || null,
            // Same signal sendMagicLinkSimplified sets: explicit flag, or a new_ person id.
            isNewUser: magicLinkIsNewUser({ isNewUser: options.isNewUser, personId: personId }),
            createdAt: new Date(),
            expiresAt: expiresAt,
            used: false
        };

        await wixData.insert(CONFIG.MAGIC_LINKS_COLLECTION, linkData, { suppressAuth: true });

        console.log(`[OK] Magic link generated for ${personId} (${options.email || 'no-email'})`);
        return token;

    } catch (error) {
        console.error('Error generating magic link:', error);
        throw error;
    }
}

/**
 * Validate magic link token and create session
 */
export async function onMagicLinkLoginV2(token) {
    try {
        if (!token) {
            return { ok: false, message: 'No token provided' };
        }

        // Find the magic link (allow used ones for grace period check)
        const results = await wixData.query(CONFIG.MAGIC_LINKS_COLLECTION)
            .eq('token', token)
            .find({ suppressAuth: true });

        if (results.items.length === 0) {
            return { ok: false, message: 'Invalid or expired link' };
        }

        const linkData = results.items[0];
        const linkIsNewUser = magicLinkIsNewUser(linkData);
        const now = new Date();

        // Anti-Scanner Logic: Allow reused token within grace period (idempotency)
        if (linkData.used) {
            const usedAt = new Date(linkData.usedAt);
            const timeDiff = now - usedAt;
            if (!linkData.usedAt || Number.isNaN(usedAt.getTime())) {
                console.warn('[!] Token marked used without valid usedAt; treating as used.');
                return { ok: false, message: 'Link already used' };
            }
            if (timeDiff < CONFIG.MAGIC_LINK_GRACE_PERIOD_MS) {
                console.log('[!] Token reused within grace period (Scanner defense)');
                const graceRole = elevateRoleIfSuperAdmin(linkData.role, linkData.email);
                const gracePersonId = isSuperAdminEmail(linkData.email)
                    ? (linkData.personId || SUPER_ADMIN_PERSON_ID)
                    : linkData.personId;
                const sessionToken = await createCustomSession(
                    gracePersonId,
                    graceRole,
                    linkData.caseId,
                    {
                        email: linkData.email,
                        phone: linkData.phone,
                        name: linkData.name,
                        isNewUser: linkIsNewUser
                    }
                );
                return {
                    ok: true,
                    sessionToken: sessionToken,
                    wixSessionToken: null,
                    role: graceRole,
                    personId: gracePersonId,
                    isNewUser: linkIsNewUser,
                    isSuperAdmin: isSuperAdminEmail(linkData.email)
                };
            }
            return { ok: false, message: 'Link already used' };
        }

        // ... Normal flow ...

        // Check expiration
        if (new Date(linkData.expiresAt) < now) {
            return { ok: false, message: 'Link has expired' };
        }

        // Mark as used
        linkData.used = true;
        linkData.usedAt = now;
        await wixData.update(CONFIG.MAGIC_LINKS_COLLECTION, linkData, { suppressAuth: true });

        // Super admin: force admin role + stable personId on magic-link login
        const loginRole = elevateRoleIfSuperAdmin(linkData.role, linkData.email);
        const loginPersonId = isSuperAdminEmail(linkData.email)
            ? (linkData.personId || SUPER_ADMIN_PERSON_ID)
            : linkData.personId;

        // Create session
        const sessionToken = await createCustomSession(
            loginPersonId,
            loginRole,
            linkData.caseId,
            {
                email: linkData.email,
                phone: linkData.phone,
                name: linkData.name,
                isNewUser: linkIsNewUser
            }
        );

        return {
            ok: true,
            sessionToken: sessionToken,
            wixSessionToken: null,
            role: loginRole,
            personId: loginPersonId,
            isNewUser: linkIsNewUser,
            isSuperAdmin: isSuperAdminEmail(linkData.email)
        };

    } catch (error) {
        console.error('Error validating magic link:', error);
        return { ok: false, message: error.message };
    }
}

