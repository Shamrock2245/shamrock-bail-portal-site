/**
 * Signing Session & Fast Recovery Service
 * File: backend/signing-session-service.jsw
 * 
 * Provides signing session validation, 1-tap instant link re-issuance via SMS,
 * and completion receipt tracking for DocuSeal / Netlify signing launchpad.
 * 
 * Boundary Doctrine:
 * - Wix displays the staff-issued DocuSeal session.
 * - Expired sessions alert Super CRM staff; Wix never mints a signing URL.
 * - Supports any signing order (Indemnitor first, Defendant later, Co-indemnitor last).
 * 
 * @module signing-session-service
 */

import wixData from 'wix-data';
import { COLLECTIONS } from 'public/collectionIds';
import { callGasAction } from 'backend/gasIntegration';
import { sendBlueBubblesMessage } from 'backend/bluebubbles';

function isApprovedDocuSealSigningUrl(signUrl) {
    if (!signUrl || typeof signUrl !== 'string') return false;
    try {
        const parsed = new URL(signUrl.trim());
        if (parsed.protocol !== 'https:') return false;
        const host = parsed.hostname.toLowerCase();
        return host === 'sign.shamrockbailbonds.biz' || host === 'docuseal.com' || host.endsWith('.docuseal.com');
    } catch (e) {
        return false;
    }
}

/**
 * Validate active signing session or detect expiry
 * @param {Object} params
 * @param {string} params.caseId - Case ID
 * @param {string} params.role - 'defendant' | 'indemnitor' | 'coindemnitor'
 * @param {string} [params.signUrl] - Direct signing URL
 * @returns {Promise<{valid: boolean, expired?: boolean, signingUrl?: string, phone?: string, error?: string}>}
 */
export async function validateSigningSession(params) {
    const { caseId, role = 'indemnitor', signUrl } = params || {};

    try {
        const isDirectUrlValid = isApprovedDocuSealSigningUrl(signUrl);

        if (!caseId && isDirectUrlValid) {
            return { valid: true, signingUrl: signUrl };
        }

        if (!caseId) {
            return { valid: false, expired: true, error: 'NO_CASE_ID' };
        }

        // 1. Query Cases CMS
        const caseQuery = await wixData.query(COLLECTIONS.CASES || 'Cases')
            .eq('caseId', caseId)
            .limit(1)
            .find({ suppressAuth: true });

        if (caseQuery.items.length > 0) {
            const c = caseQuery.items[0];
            const sessionExpired = c.status === 'expired' || c.signingLinkExpired || c.status === 'void';
            
            if (sessionExpired) {
                return {
                    valid: false,
                    expired: true,
                    phone: c.indemnitorPhone || c.defendantPhone || ''
                };
            }

            const approvedUrl = isApprovedDocuSealSigningUrl(c.signingUrl) ? c.signingUrl : (isDirectUrlValid ? signUrl : '');
            return {
                valid: !!approvedUrl,
                expired: !approvedUrl,
                signingUrl: approvedUrl,
                signingSessionId: c.signingSessionId || '',
                phone: c.indemnitorPhone || c.defendantPhone || ''
            };
        }

        // 2. Query IntakeQueue CMS fallback
        const intakeQuery = await wixData.query(COLLECTIONS.INTAKE_QUEUE || 'IntakeQueue')
            .eq('caseId', caseId)
            .limit(1)
            .find({ suppressAuth: true });

        if (intakeQuery.items.length > 0) {
            const item = intakeQuery.items[0];
            const approvedIntakeUrl = isApprovedDocuSealSigningUrl(item.signingUrl) ? item.signingUrl : (isDirectUrlValid ? signUrl : '');
            return {
                valid: !!approvedIntakeUrl,
                expired: !approvedIntakeUrl,
                signingUrl: approvedIntakeUrl,
                phone: item.phone || item.indemnitorPhone || item.defendantPhone || ''
            };
        }

        // If direct URL is valid, allow launchpad to proceed
        if (isDirectUrlValid) {
            return { valid: true, signingUrl: signUrl };
        }

        return { valid: false, expired: true, error: 'CASE_NOT_FOUND' };

    } catch (e) {
        console.warn("⚠️ [Signing Session] Validation warning:", e.message);
        return { valid: false, expired: true, error: e.message };
    }
}

/**
 * 1-Tap "Send me a new link" recovery via SMS
 * @param {Object} params
 * @param {string} params.caseId - Case ID
 * @param {string} params.role - 'defendant' | 'indemnitor' | 'coindemnitor'
 * @param {string} params.phone - Client phone number
 * @returns {Promise<{success: boolean, message: string}>}
 */
export async function requestFreshSigningLink(params) {
    const { caseId, role = 'indemnitor', phone } = params || {};

    if (!phone && !caseId) {
        return { success: false, message: 'Phone number or Case ID is required.' };
    }

    try {
        console.log(`📱 [1-Tap Re-send] Client requested a staff-issued signing link for Case ${caseId} (${phone})...`);

        await callGasAction('notifyStaffPacketPending', {
            caseId,
            role,
            phone,
            reason: 'fresh_signing_link_request'
        });

        return {
            success: true,
            message: 'A Shamrock bondsman will send your official signing link from Super CRM. Need help now? Call (239) 332-2245.'
        };

    } catch (error) {
        console.error("❌ [Signing Link Re-send] Error:", error);
        return {
            success: false,
            message: 'Could not send message automatically. Please call our 24/7 desk at (239) 332-2245.'
        };
    }
}

/**
 * Record signature completion event & dispatch SMS confirmation receipt
 * @param {Object} params
 * @param {string} params.caseId - Case ID
 * @param {string} params.role - Signer role ('defendant' | 'indemnitor' | 'coindemnitor')
 * @param {string} [params.signerPhone] - Signer phone
 * @param {string} [params.sessionToken] - Active session token
 * @param {string} [params.submissionId] - DocuSeal submission ID
 * @returns {Promise<{success: boolean, error?: string}>}
 */
export async function recordSignatureCompletion(params) {
    const { caseId, role = 'indemnitor', signerPhone, sessionToken, submissionId } = params || {};

    if (!caseId) {
        return { success: false, error: 'MISSING_CASE_ID' };
    }

    try {
        console.log(`🎉 [Signing Complete] Signature captured for Case ${caseId} (${role})`);

        // 1. Update Case record in CMS
        const caseQuery = await wixData.query(COLLECTIONS.CASES || 'Cases')
            .eq('caseId', caseId)
            .limit(1)
            .find({ suppressAuth: true });

        if (caseQuery.items.length > 0) {
            const item = caseQuery.items[0];
            item.status = 'signed';
            item.lastSignedRole = role;
            item.signedAt = new Date();
            if (submissionId) item.docusealSubmissionId = submissionId;
            await wixData.update(COLLECTIONS.CASES || 'Cases', item, { suppressAuth: true });
        }

        // 2. Update IntakeQueue record if present
        try {
            const intakeQuery = await wixData.query(COLLECTIONS.INTAKE_QUEUE || 'IntakeQueue')
                .eq('caseId', caseId)
                .limit(1)
                .find({ suppressAuth: true });

            if (intakeQuery.items.length > 0) {
                const intakeItem = intakeQuery.items[0];
                intakeItem.status = 'signed';
                intakeItem.signedAt = new Date();
                await wixData.update(COLLECTIONS.INTAKE_QUEUE || 'IntakeQueue', intakeItem, { suppressAuth: true });
            }
        } catch (intakeErr) {
            console.warn("Intake status update non-fatal:", intakeErr.message);
        }

        // 3. Notify GAS & Super CRM
        await callGasAction('notifySigningCompleted', {
            caseId,
            role,
            signerPhone,
            sessionToken,
            submissionId
        }).catch(gasErr => console.warn("GAS notification non-fatal:", gasErr.message));

        // 4. Send BlueBubbles Receipt
        if (signerPhone) {
            await sendBlueBubblesMessage({
                to: signerPhone,
                text: `☘️ Shamrock Bail Bonds: Signature complete for Case ${caseId}. Your paperwork is locked and submitted to the bond desk. Download copies anytime in your client portal. Phone: (239) 332-2245.`
            }).catch(e => console.warn('Receipt dispatch non-fatal:', e.message));
        }

        return { success: true };

    } catch (err) {
        console.error("❌ [Signing Complete] Error updating case status:", err);
        return { success: false, error: err.message };
    }
}

export default {
    validateSigningSession,
    requestFreshSigningLink,
    recordSignatureCompletion
};

