import wixCrmBackend from 'wix-crm-backend';
import wixData from 'wix-data';
import { trackEvent } from 'backend/analytics';

/**
 * Submits Bail School interest: creates/updates a Wix Contact + optional CMS row.
 *
 * Accepts either:
 *   submitBailSchoolInterest('person@example.com')
 *   submitBailSchoolInterest({ email, name, source })
 *
 * Always returns { success, ok, contactId?, message? } so page code can rely on either flag.
 *
 * @param {string|{email?: string, name?: string, source?: string}} input
 * @returns {Promise<{success: boolean, ok: boolean, contactId?: string, message?: string}>}
 */
export async function submitBailSchoolInterest(input) {
    let email = '';
    let name = '';
    let source = 'Bail School page';

    if (typeof input === 'string') {
        email = input;
    } else if (input && typeof input === 'object') {
        email = input.email || input.Email || '';
        name = input.name || input.Name || '';
        source = input.source || source;
    }

    const normalized = String(email || '').trim().toLowerCase();

    if (!normalized || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalized)) {
        return {
            success: false,
            ok: false,
            message: 'Please enter a valid email address'
        };
    }

    try {
        const cleanName = String(name || '').trim();
        // Shape matches existing working call sites across the portal (string emails array)
        const contactInfo = {
            emails: [normalized],
            labels: ['Bail School Interest']
        };
        if (cleanName) {
            const parts = cleanName.split(/\s+/);
            contactInfo.name = {
                first: parts[0] || cleanName,
                last: parts.slice(1).join(' ') || ''
            };
        }

        // appendOrCreateContact may return contactId string or { contactId }
        const contactResult = await wixCrmBackend.contacts.appendOrCreateContact(contactInfo);
        const contactId =
            typeof contactResult === 'string'
                ? contactResult
                : (contactResult && (contactResult.contactId || contactResult._id)) || null;

        try {
            await wixData.insert('BailSchoolSignups', {
                title: normalized,
                email: normalized,
                name: cleanName || null,
                contactId: contactId,
                signupDate: new Date(),
                source: source
            });
        } catch (dbError) {
            // Contact already created — collection may be missing or schema-mismatched.
            console.warn('BailSchoolSignups insert failed (contact still saved):', dbError);
        }

        try {
            await trackEvent('bail_school_signup', {
                email: normalized,
                contactId,
                page: source,
                name: cleanName || undefined
            });
        } catch (trackErr) {
            console.warn('bail_school_signup trackEvent failed:', trackErr);
        }

        return {
            success: true,
            ok: true,
            contactId: contactId || undefined,
            message: 'Subscribed'
        };
    } catch (error) {
        console.error('submitBailSchoolInterest error:', error);
        return {
            success: false,
            ok: false,
            message: 'Server error. Please try again or call (239) 332-2245.'
        };
    }
}
