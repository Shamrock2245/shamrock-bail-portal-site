/**
 * comm-prefs-sync.jsw — Wix Backend Module
 * Shamrock Bail Bonds
 *
 * Syncs client communication preferences from Wix CMS → GAS backend
 * so that TheCloser, CourtReminders, and other outbound handlers
 * can check opt-in/opt-out status before sending messages.
 *
 * Public web methods:
 *   saveCommunicationPreferences — require a session or personal signed
 *     link, validate, await the GAS consent gate, then persist.
 *   getCommunicationPreferences — load prefs for that same authenticated
 *     contact only.
 *
 * Backend-only (not client-invokable):
 *   syncCommPrefsToGas
 *   mintCommunicationPreferencesLink — mint a signed personal link token
 *     for leads / Node-RED. Does not send texts or emails.
 *
 * Target: GAS doPost → action 'updateCommPrefs' → CommPrefsGate.js
 */

import { fetch } from 'wix-fetch';
import wixData from 'wix-data';
import { currentMember } from 'wix-members-backend';
import { getGasWebAppUrl } from 'backend/secretsManager';
import { getSecret } from 'wix-secrets-backend';
import { validateCustomSession } from 'backend/portal-auth';
import { COLLECTIONS } from 'public/collectionIds';
import {
    COMM_PREFS_LINK_SECRET_NAME,
    interpretGasCommPrefsResult,
    mintCommPrefsLinkToken,
    phoneDigits,
    saveCommunicationPreferences as savePrefs,
    getCommunicationPreferences as getPrefs
} from 'backend/commPrefs';

/**
 * Push communication preferences to the GAS consent gate.
 * Uses the existing getGasWebAppUrl() helper. Does not change the GAS URL.
 *
 * @param {Object} prefs — { phone, firstName, lastName, email, smsOptIn, whatsappOptIn, telegramOptIn, emailOptIn }
 * @returns {Object}     — { success, message|error, result? }
 */
export async function syncCommPrefsToGas(prefs) {
    try {
        if (!prefs || !prefs.phone) {
            return { success: false, error: 'Phone number is required for GAS sync.' };
        }

        const gasUrl = await getGasWebAppUrl();
        const apiKey = await getSecret('GAS_API_KEY');

        if (!gasUrl) {
            console.warn('[CommPrefsSync] No GAS URL configured — skipping sync.');
            return { success: false, error: 'GAS URL not configured.' };
        }

        const response = await fetch(gasUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'updateCommPrefs',
                apiKey: apiKey || '',
                phone:          prefs.phone,
                firstName:      prefs.firstName || '',
                lastName:       prefs.lastName || '',
                email:          prefs.email || '',
                smsOptIn:       prefs.smsOptIn === true,
                whatsappOptIn:  prefs.whatsappOptIn === true,
                telegramOptIn:  prefs.telegramOptIn === true,
                emailOptIn:     prefs.emailOptIn === true
            })
        });

        let body = null;
        try {
            body = await response.json();
        } catch (e) {
            if (response.ok) {
                return { success: false, error: 'GAS consent gate returned an unreadable response.' };
            }
        }
        return interpretGasCommPrefsResult(response, body);

    } catch (err) {
        console.error('[CommPrefsSync] Error syncing to GAS:', err);
        return { success: false, error: err.message };
    }
}


/**
 * Read current consent from the GAS gate.
 * Uses the existing getGasWebAppUrl() helper and GAS_API_KEY, same
 * pattern as syncCommPrefsToGas. Calls doPost action 'getCommPreferences'.
 * Does not change the GAS URL.
 *
 * @returns {{ ok: true, prefs: Object } | { ok: false, error: string }}
 */
export async function getCommPrefsFromGas(phone) {
    try {
        if (!phone) {
            return { ok: false, error: 'Phone number is required for GAS sync.' };
        }

        const gasUrl = await getGasWebAppUrl();
        const apiKey = await getSecret('GAS_API_KEY');

        if (!gasUrl) {
            console.warn('[CommPrefsSync] No GAS URL configured — cannot read prefs.');
            return { ok: false, error: 'GAS URL not configured.' };
        }

        const response = await fetch(gasUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'getCommPreferences',
                apiKey: apiKey || '',
                phone: phone
            })
        });

        let body = null;
        try {
            body = await response.json();
        } catch (e) {
            return { ok: false, error: 'GAS consent gate returned an unreadable response.' };
        }

        const interpreted = interpretGasCommPrefsResult(response, body);
        if (!interpreted.success) {
            return { ok: false, error: interpreted.error || 'Could not read current consent from the gate.' };
        }
        return { ok: true, prefs: (body && body.prefs) || null };
    } catch (err) {
        console.error('[CommPrefsSync] Error reading from GAS:', err);
        return { ok: false, error: err.message || 'Could not read current consent from the gate.' };
    }
}

function phoneQueryVariants(phone) {
    const digits = phoneDigits(phone);
    if (!digits || digits.length < 10) return [];
    return [
        digits,
        '+1' + digits,
        '1' + digits,
        '(' + digits.slice(0, 3) + ') ' + digits.slice(3, 6) + '-' + digits.slice(6)
    ];
}

function usersDeps() {
    return {
        validateSession: validateCustomSession,
        getCurrentMember: async () => {
            try {
                return await currentMember.getMember();
            } catch (e) {
                return null;
            }
        },
        getLinkSecret: async () => {
            try {
                return (await getSecret(COMM_PREFS_LINK_SECRET_NAME)) || '';
            } catch (e) {
                return '';
            }
        },
        queryUsersByContact: async ({ personId, phone, email }) => {
            if (personId) {
                const byId = await wixData.query(COLLECTIONS.PORTAL_USERS)
                    .eq('personId', personId)
                    .limit(1)
                    .find({ suppressAuth: true });
                if (byId && byId.items && byId.items[0]) return byId.items[0];
            }
            if (email) {
                const normalized = String(email).trim().toLowerCase();
                const byEmail = await wixData.query(COLLECTIONS.PORTAL_USERS)
                    .eq('email', normalized)
                    .limit(1)
                    .find({ suppressAuth: true });
                if (byEmail && byEmail.items && byEmail.items[0]) return byEmail.items[0];
            }
            const variants = phoneQueryVariants(phone);
            for (let i = 0; i < variants.length; i++) {
                const byPhone = await wixData.query(COLLECTIONS.PORTAL_USERS)
                    .eq('phone', variants[i])
                    .limit(1)
                    .find({ suppressAuth: true });
                if (byPhone && byPhone.items && byPhone.items[0]) return byPhone.items[0];
            }
            return null;
        },
        updateUser: (record) => wixData.update(COLLECTIONS.PORTAL_USERS, record, { suppressAuth: true }),
        insertUser: (record) => wixData.insert(COLLECTIONS.PORTAL_USERS, record, { suppressAuth: true }),
        syncToGas: syncCommPrefsToGas,
        getGasPrefs: getCommPrefsFromGas
    };
}

/**
 * Validate, await the GAS consent gate, then persist Portal Users.
 * Requires a validated session/member or a personal signed link.
 * All-channels-off is stored as explicit false opt-outs.
 * The GAS upsert key is the server-derived phone, not the client body.
 */
export async function saveCommunicationPreferences(input) {
    return savePrefs(input, usersDeps());
}

/**
 * Load saved preferences for the authenticated contact only.
 */
export async function getCommunicationPreferences(input) {
    return getPrefs(input, usersDeps());
}

/**
 * Mint a personal signed link token (HMAC over contact id or phone,
 * channel scope, and expiry). For leads / Node-RED. Not client-invokable.
 * Does not send texts or emails. Signs with COMM_PREFS_LINK_SECRET.
 */
export async function mintCommunicationPreferencesLink(input) {
    return mintCommPrefsLinkToken(input, usersDeps());
}
