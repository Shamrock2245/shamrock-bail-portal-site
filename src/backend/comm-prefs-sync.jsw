/**
 * comm-prefs-sync.jsw — Wix Backend Module
 * Shamrock Bail Bonds
 *
 * Syncs client communication preferences from Wix CMS → GAS backend
 * so that TheCloser, CourtReminders, and other outbound handlers
 * can check opt-in/opt-out status before sending messages.
 *
 * Public web methods:
 *   saveCommunicationPreferences — validate, await the GAS consent gate,
 *     then persist. The Communication Preferences page calls only this
 *     to write preferences.
 *   getCommunicationPreferences — load the session user's saved prefs.
 *
 * syncCommPrefsToGas is for backend callers only (not client-invokable).
 * Target: GAS doPost → action 'updateCommPrefs' → CommPrefsGate.js
 */

import { fetch } from 'wix-fetch';
import wixData from 'wix-data';
import { getGasWebAppUrl } from 'backend/secretsManager';
import { getSecret } from 'wix-secrets-backend';
import { validateCustomSession } from 'backend/portal-auth';
import { COLLECTIONS } from 'public/collectionIds';
import {
    interpretGasCommPrefsResult,
    saveCommunicationPreferences as savePrefs,
    getCommunicationPreferences as getPrefs
} from 'backend/commPrefs';

/**
 * Push communication preferences to the GAS consent gate.
 * Uses the existing getGasWebAppUrl() helper. Does not change the GAS URL.
 *
 * @param {Object} prefs — { phone, firstName, lastName, email, smsOptIn, whatsappOptIn, telegramOptIn, emailOptIn }
 * @returns {Object}     — { success, message|error, result? }
 */
export async function syncCommPrefsToGas(prefs) {
    try {
        if (!prefs || !prefs.phone) {
            return { success: false, error: 'Phone number is required for GAS sync.' };
        }

        const gasUrl = await getGasWebAppUrl();
        const apiKey = await getSecret('GAS_API_KEY');

        if (!gasUrl) {
            console.warn('[CommPrefsSync] No GAS URL configured — skipping sync.');
            return { success: false, error: 'GAS URL not configured.' };
        }

        const response = await fetch(gasUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'updateCommPrefs',
                apiKey: apiKey || '',
                phone:          prefs.phone,
                firstName:      prefs.firstName || '',
                lastName:       prefs.lastName || '',
                email:          prefs.email || '',
                smsOptIn:       prefs.smsOptIn === true,
                whatsappOptIn:  prefs.whatsappOptIn === true,
                telegramOptIn:  prefs.telegramOptIn === true,
                emailOptIn:     prefs.emailOptIn === true
            })
        });

        let body = null;
        try {
            body = await response.json();
        } catch (e) {
            if (response.ok) {
                return { success: false, error: 'GAS consent gate returned an unreadable response.' };
            }
        }
        return interpretGasCommPrefsResult(response, body);

    } catch (err) {
        console.error('[CommPrefsSync] Error syncing to GAS:', err);
        return { success: false, error: err.message };
    }
}

function usersDeps() {
    return {
        validateSession: validateCustomSession,
        queryUsers: async (personId) => {
            const results = await wixData.query(COLLECTIONS.PORTAL_USERS)
                .eq('personId', personId)
                .limit(1)
                .find({ suppressAuth: true });
            return (results && results.items && results.items[0]) || null;
        },
        updateUser: (record) => wixData.update(COLLECTIONS.PORTAL_USERS, record, { suppressAuth: true }),
        insertUser: (record) => wixData.insert(COLLECTIONS.PORTAL_USERS, record, { suppressAuth: true }),
        syncToGas: syncCommPrefsToGas
    };
}

/**
 * Validate, await the GAS consent gate, then persist Portal Users.
 * All-channels-off is stored as explicit false opt-outs.
 * personId is taken from the validated session token, not the client body.
 */
export async function saveCommunicationPreferences(input) {
    return savePrefs(input, usersDeps());
}

/**
 * Load saved preferences for the validated session user only.
 */
export async function getCommunicationPreferences(input) {
    return getPrefs(input, usersDeps());
}
